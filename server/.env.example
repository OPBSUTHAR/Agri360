# Server Configuration
PORT=5000
NODE_ENV=development
# Set to 'production' in prod to enable secure cookies etc.

# Database - NEVER commit real URI, use localhost example
MONGO_URI=mongodb://localhost:27017/agri360
# For production Atlas example:
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/agri360?retryWrites=true&w=majority

# JWT - generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_generate_a_64_char_random_hex_string
JWT_EXPIRE=7d
JWT_COOKIE_EXPIRE=30

# Client URL for CORS
CLIENT_URL=http://localhost:3000

# AWS S3 (for image storage) - use IAM roles or env vars in production
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=your_aws_region
S3_BUCKET_NAME=agri360-images

# AI Services (Example - you can use TensorFlow.js or external APIs)
AI_PROCESSING_ENDPOINT=http://localhost:5001
TENSORFLOW_MODEL_PATH=./models/crop_detection

# MQTT Broker (for IoT devices)
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_USERNAME=mqtt_user
MQTT_PASSWORD=CHANGE_ME_strong_mqtt_password

# Weather API - get from https://openweathermap.org/api
# NEVER commit real key. Copy this file to .env and fill it.
WEATHER_API_KEY=your_openweathermap_api_key_here
